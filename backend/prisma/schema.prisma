datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String
  role                Role                 @default(CUSTOMER)
  customerId          String?              @unique
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([role])
  @@index([createdAt])
}

model Customer {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  phone         String?
  address       String?
  city          String?
  state         String?
  postalCode    String?
  country       String?
  user          User?
  subscriptions Subscription[]
  invoices      Invoice[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([email])
  @@index([name])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id                String                  @id @default(uuid())
  name              String
  type              String                  @default("SERVICE")
  salesPrice        Decimal                 @db.Decimal(12, 2)
  costPrice         Decimal                 @default(0) @db.Decimal(12, 2)
  notes             String?
  variants          ProductVariant[]
  taxes             ProductTax[]
  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([name])
  @@index([createdAt])
}

model ProductVariant {
  id                String                  @id @default(uuid())
  productId         String
  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute         String
  value             String
  extraPrice        Decimal                 @default(0) @db.Decimal(12, 2)
  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([productId])
  @@index([attribute, value])
}

model Plan {
  id                 String              @id @default(uuid())
  name               String
  price              Decimal             @db.Decimal(12, 2)
  billingPeriod      BillingPeriod
  minQuantity        Int                 @default(1)
  availableFrom      DateTime?
  availableTo        DateTime?
  autoClose          Boolean             @default(false)
  closable           Boolean             @default(true)
  pausable           Boolean             @default(true)
  renewable          Boolean             @default(true)
  subscriptions      Subscription[]
  quotationTemplates QuotationTemplate[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([billingPeriod])
  @@index([createdAt])
}

model QuotationTemplate {
  id           String                  @id @default(uuid())
  name         String
  validityDays Int                     @default(30)
  planId       String
  plan         Plan                    @relation(fields: [planId], references: [id], onDelete: Restrict)
  lines        QuotationTemplateLine[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([planId])
  @@index([createdAt])
}

model QuotationTemplateLine {
  id                  String             @id @default(uuid())
  quotationTemplateId String
  quotationTemplate   QuotationTemplate  @relation(fields: [quotationTemplateId], references: [id], onDelete: Cascade)
  productId           String
  product             Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId           String?
  variant             ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity            Int                @default(1)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([quotationTemplateId])
  @@index([productId])
}

model Subscription {
  id             String             @id @default(uuid())
  number         String             @unique
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  planId         String
  plan           Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  startDate      DateTime
  expiryDate     DateTime?
  paymentTerms   Int                @default(15)
  nextBillingDate DateTime
  status         SubscriptionStatus @default(DRAFT)
  lines          SubscriptionLine[]
  invoices       Invoice[]
  discountUsages DiscountUsage[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([nextBillingDate])
  @@index([createdAt])
}

model SubscriptionLine {
  id             String          @id @default(uuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(12, 2)
  taxRate        Decimal         @default(0) @db.Decimal(5, 2)
  amount         Decimal         @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([subscriptionId])
  @@index([productId])
}

model Tax {
  id        String       @id @default(uuid())
  name      String
  rate      Decimal      @db.Decimal(5, 2)
  products  ProductTax[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([name])
  @@index([createdAt])
}

model ProductTax {
  productId String
  taxId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tax       Tax     @relation(fields: [taxId], references: [id], onDelete: Cascade)

  @@id([productId, taxId])
}

model Discount {
  id                    String          @id @default(uuid())
  name                  String
  type                  DiscountType
  value                 Decimal         @db.Decimal(12, 2)
  minPurchase           Decimal         @default(0) @db.Decimal(12, 2)
  minQuantity           Int             @default(0)
  startDate             DateTime?
  endDate               DateTime?
  usageLimit            Int?
  usedCount             Int             @default(0)
  scope                 DiscountScope
  targetProductIds      String[]        @default([])
  targetSubscriptionIds String[]        @default([])
  usages                DiscountUsage[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([scope])
  @@index([startDate, endDate])
  @@index([createdAt])
}

model DiscountUsage {
  id             String        @id @default(uuid())
  discountId     String
  discount       Discount      @relation(fields: [discountId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  customerId     String?
  amount         Decimal       @db.Decimal(12, 2)
  usedAt         DateTime      @default(now())

  @@index([discountId])
  @@index([invoiceId])
  @@index([subscriptionId])
}

model Invoice {
  id                 String          @id @default(uuid())
  number             String          @unique
  subscriptionId     String?
  subscription       Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  customerId         String
  customer           Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  issueDate          DateTime        @default(now())
  dueDate            DateTime
  status             InvoiceStatus   @default(DRAFT)
  subtotal           Decimal         @default(0) @db.Decimal(12, 2)
  discountTotal      Decimal         @default(0) @db.Decimal(12, 2)
  taxTotal           Decimal         @default(0) @db.Decimal(12, 2)
  total              Decimal         @default(0) @db.Decimal(12, 2)
  amountPaid         Decimal         @default(0) @db.Decimal(12, 2)
  lines              InvoiceLine[]
  payments           Payment[]
  discountUsages     DiscountUsage[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([subscriptionId, billingPeriodStart])
  @@index([status])
  @@index([customerId])
  @@index([subscriptionId])
  @@index([dueDate])
  @@index([createdAt])
}

model InvoiceLine {
  id             String          @id @default(uuid())
  invoiceId      String
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(12, 2)
  taxRate        Decimal         @default(0) @db.Decimal(5, 2)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  amount         Decimal         @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method    String
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([date])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([timestamp])
}

model SequenceTracker {
  id           String   @id @default(uuid())
  prefix       String   @unique
  currentValue Int      @default(0)
  updatedAt    DateTime @updatedAt
}
